#!/bin/bash
# Creates Katello content: products, repositories (download on demand),
# GPG content credentials, rolling content views (one per product) and
# activation keys (AK <product>).
# Rendered by OpenTofu (templates/katello-repos.sh.tmpl) from the
# katello_gpg_keys / katello_yum_repos / katello_deb_repos /
# katello_subscription_manager_deb_repos variables.
# Logs: /root/katello-repos.log

set -uo pipefail

exec > >(tee /root/katello-repos.log) 2>&1

ORG="Default Organization"
SENTINEL="/root/katello-repos.published"

echo "==== Creating Katello content (products/repos/CVs/AKs) ===="

if ! hammer ping >/dev/null 2>&1; then
  echo "ERROR: hammer/Foreman API unreachable - aborting"
  exit 1
fi

touch "$SENTINEL"

gpg_id() {
  hammer content-credential info --organization "$ORG" --name "$1" 2>/dev/null \
    | awk '/^ *Id:/{print $2; exit}'
}

ensure_product() {
  hammer product create --organization "$ORG" --name "$1" \
    --description "Managed by Terraform" 2>/dev/null \
    || echo "product '$1' already exists"
}

cv_id() {
  hammer content-view info --organization "$ORG" --name "$1" 2>/dev/null \
    | awk '/^ *Id:/{print $2; exit}'
}

ensure_cv() {
  hammer content-view create --organization "$ORG" --name "$1" 2>/dev/null \
    || echo "content view '$1' already exists"
}

ensure_ak() {
  hammer activation-key info --organization "$ORG" --name "$1" >/dev/null 2>&1 \
    || hammer activation-key create --organization "$ORG" --name "$1" \
         --content-view "${2}" --lifecycle-environment Library \
         --unlimited-hosts 2>&1 \
    || echo "WARN: activation key '$1' create failed"
}

# ------------------------------------------------------------------
# GPG content credentials
# ------------------------------------------------------------------
mkdir -p /root/gpg-keys

%{ for i, key in katello_gpg_keys ~}
if curl -sSf --max-time 30 -o /root/gpg-keys/gpg-${i}.key "${key.url}"; then
  chmod 644 /root/gpg-keys/gpg-${i}.key
  if ! hammer content-credential info --organization "$ORG" --name "${key.name}" >/dev/null 2>&1; then
    hammer content-credential create --organization "$ORG" --name "${key.name}" \
      --content-type gpg_key --path /root/gpg-keys/gpg-${i}.key \
      || echo "WARN: could not create content credential '${key.name}'"
  else
    echo "content credential '${key.name}' already exists"
  fi
else
  echo "WARNING: could not download GPG key from ${key.url}"
fi
%{ endfor ~}

# ------------------------------------------------------------------
# Yum (RPM) repositories
# ------------------------------------------------------------------
%{ for r in katello_yum_repos ~}
ensure_product "${r.product}"
GPG_ARGS=""
%{ if r.gpg_key != "" ~}
GPG_ID=$(gpg_id "${r.gpg_key}")
if [ -n "$GPG_ID" ]; then GPG_ARGS="--gpg-key-id $GPG_ID"; fi
%{ endif ~}
echo "Creating yum repo ${r.product} / ${r.name}"
hammer repository create \
  --organization "$ORG" \
  --product "${r.product}" \
  --name "${r.name}" \
  --content-type yum \
  --url "${r.url}" \
  --download-policy "${r.download_policy}" \
  $GPG_ARGS \
  || echo "WARN: yum repo ${r.name} failed (already exists?)"
%{ endfor ~}

# ------------------------------------------------------------------
# Deb (Debian/Ubuntu) repositories incl. ATIX subscription-manager
# ------------------------------------------------------------------
%{ for r in katello_deb_all ~}
ensure_product "${r.product}"
GPG_ARGS=""
%{ if r.gpg_key != "" ~}
GPG_ID=$(gpg_id "${r.gpg_key}")
if [ -n "$GPG_ID" ]; then GPG_ARGS="--gpg-key-id $GPG_ID"; fi
%{ endif ~}
echo "Creating deb repo ${r.product} / ${r.name}"
hammer repository create \
  --organization "$ORG" \
  --product "${r.product}" \
  --name "${r.name}" \
  --content-type deb \
  --url "${r.url}" \
  --deb-releases "${r.releases}" \
  --deb-components "${r.components}" \
  --deb-architectures "${r.architectures}" \
  --download-policy "${r.download_policy}" \
  $GPG_ARGS \
  || echo "WARN: deb repo ${r.name} failed (already exists?)"
%{ endfor ~}

# ------------------------------------------------------------------
# Background metadata sync for every product
# ------------------------------------------------------------------
echo "==== Triggering background syncs ===="
PRODUCTS_FILE=$(mktemp)
%{ for r in katello_yum_repos ~}
echo "${r.product}" >> "$PRODUCTS_FILE"
%{ endfor ~}
%{ for r in katello_deb_all ~}
echo "${r.product}" >> "$PRODUCTS_FILE"
%{ endfor ~}

sort -u "$PRODUCTS_FILE" | while read -r p; do
  hammer product synchronize --async --organization "$ORG" --name "$p" \
    >/dev/null 2>&1 || echo "WARN: sync trigger failed for '$p'"
done

# ------------------------------------------------------------------
# Rolling content views (one per product, all repos of the product) + AKs
# ------------------------------------------------------------------
%{ if katello_activation_keys ~}
echo "==== Creating rolling content views & activation keys ===="

sort -u "$PRODUCTS_FILE" | while read -r p; do
  ensure_cv "$p"
done

%{ for r in katello_yum_repos ~}
CVID=$(cv_id "${r.product}")
if [ -n "$CVID" ]; then
  hammer content-view add-repository --id "$CVID" --product "${r.product}" --repository "${r.name}" \
    >/dev/null 2>&1 \
    || echo "repo ${r.name} already in CV ${r.product}"
fi
%{ endfor ~}
%{ for r in katello_deb_all ~}
CVID=$(cv_id "${r.product}")
if [ -n "$CVID" ]; then
  hammer content-view add-repository --id "$CVID" --product "${r.product}" --repository "${r.name}" \
    >/dev/null 2>&1 \
    || echo "repo ${r.name} already in CV ${r.product}"
fi
%{ endfor ~}

sort -u "$PRODUCTS_FILE" | while read -r p; do
  if grep -qx "$p" "$SENTINEL" 2>/dev/null; then
    echo "CV '$p' already published (sentinel)"
  else
    if hammer content-view publish --async --name "$p" --organization "$ORG" >/dev/null 2>&1; then
      echo "publish queued: $p"
      echo "$p" >> "$SENTINEL"
    else
      echo "WARN: publish failed for '$p' (retry after sync finished)"
    fi
  fi
done

# activation keys can only be created after the content views have a
# published version in the Library - wait for the publish tasks
echo "==== Waiting for content view publishes to finish (max 10 min) ===="
for i in $(seq 1 20); do
  p=$(hammer task list 2>/dev/null | grep -c "Publish content view" || true)
  [ "$p" -eq 0 ] && break
  sleep 30
done

sort -u "$PRODUCTS_FILE" | while read -r p; do
  ensure_ak "AK $p" "$p"
done
%{ endif ~}

rm -f "$PRODUCTS_FILE"

%{ if foreman_proxmox_integration && foreman_proxmox_password != "" ~}
# ------------------------------------------------------------------
# Register the Proxmox node as a Foreman compute resource
# (hammer's cached apidoc doesn't know the Proxmox provider enum,
# so the REST API is used directly)
# ------------------------------------------------------------------
echo "==== Creating Proxmox compute resource ===="
HCONF=/root/.hammer/cli_config.yml
UHOST=$(awk '/:host:/{print $2}' "$HCONF")
UUSER=$(awk '/:username:/{print $2}' "$HCONF")
UPASS=$(awk '/:password:/{print $2}' "$HCONF")
CR_NAME="${foreman_proxmox_name}"

if curl -sk -u "$UUSER:$UPASS" "$UHOST/api/compute_resources" | grep -q '"name":"'"$CR_NAME"'"'; then
  echo "compute resource '$CR_NAME' already exists"
else
  BODY=$(printf '{"compute_resource":{"name":"%s","provider":"Proxmox","url":"%s","user":"%s","auth_method":"%s","token_id":"%s","token":"%s","password":"%s","description":"Managed by Terraform","ssl_verify_peer":"false"}}' \
    "$CR_NAME" "${foreman_proxmox_server}" "${foreman_proxmox_user}" "${foreman_proxmox_auth_method}" "${foreman_proxmox_token_id}" "${foreman_proxmox_password}" "${foreman_proxmox_password}")
  RESP=$(curl -sk -u "$UUSER:$UPASS" -H "Content-Type: application/json" -d "$BODY" "$UHOST/api/compute_resources")
  echo "$RESP" | head -c 240
  echo
  if echo "$RESP" | grep -q '"id"'; then
    echo "compute resource '$CR_NAME' created"
    CRIDv=$(echo "$RESP" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
    # The API controller filters out the Proxmox auth fields (auth_method/
    # token/token_id) - the Foreman web UI writes them, the API does not.
    # Book route: write the attrs json/yaml directly via psql (the script
    # runs as root on the Foreman/Katello host).
    {
      printf 'update compute_resources set attrs = $attrs$---\n'
      printf -- ':auth_method: %s\n:token_id: %s\n:token: %s\n' \
        "${foreman_proxmox_auth_method}" "${foreman_proxmox_token_id}" "${foreman_proxmox_password}"
      printf '$attrs$\n'
    } > /tmp/cr-attrs.sql
    su - postgres -s /bin/bash -c "psql -h /var/run/postgresql -d foreman -f /tmp/cr-attrs.sql" \
      || echo "WARN: could not persist Proxmox auth attrs via psql"
    rm -f /tmp/cr-attrs.sql /tmp/cr-attrs.yaml
  else
    echo "WARN: compute resource creation failed"
  fi
fi
%{ if foreman_compute_profiles ~}
echo "==== Creating compute profiles ===="
%{ for cp in foreman_compute_profile_list ~}
CPID=$(hammer compute-profile info --name "${cp.name}" 2>/dev/null | awk '/^ *Id:/{print $2}')
if [ -z "$CPID" ]; then
  hammer compute-profile create --name "${cp.name}" >/dev/null 2>&1
  CPID=$(hammer compute-profile info --name "${cp.name}" 2>/dev/null | awk '/^ *Id:/{print $2}')
fi
if [ -n "$CPID" ]; then
  if curl -sk -u "$UUSER:$UPASS" "$UHOST/api/compute_profiles/$CPID/compute_resources/1/compute_attributes" 2>/dev/null | grep -q '"id"'; then
    echo "compute profile '${cp.name}' values already set"
  else
    BODY=$(printf '{"compute_attribute":{"compute_attributes":{"type":"qemu","nodes":"pve","cores":"%s","sockets":"1","kvm":"1","vga":"std","memory":"%s","ostype":"l26","cpu":"cputype=kvm64","scsihw":"virtio-scsi-pci","templated":"0","boot":"cn","volumes_attributes":{"0":{"storage":"zfs_vms","size":"%s","controller":"virtio","device":0,"id":"virtio0","options":{"cache":"none","backup":"1"}}},"interfaces_attributes":{"0":{"id":"net0","model":"virtio","bridge":"vmbr0","name":""}}}}}' \
      "${cp.cores}" "${cp.memory}" "${cp.size}")
    RESP_CP=$(curl -sk -u "$UUSER:$UPASS" -H "Content-Type: application/json" -d "$BODY" "$UHOST/api/compute_profiles/$CPID/compute_resources/1/compute_attributes")
    echo "$RESP_CP" | grep -q '"id"' \
      && echo "compute profile '${cp.name}' values set (id $CPID)" \
      || echo "WARN: compute profile '${cp.name}' values failed"
  fi
else
  echo "WARN: compute profile '${cp.name}' could not be created"
fi
%{ endfor ~}
%{ endif ~}
%{ endif ~}

%{ if foreman_registration_setup ~}
# ------------------------------------------------------------------
# Global registration for all supported OSes:
#   - custom "subscription_manager_setup (custom)" snippet (ATIX subscription-
#     manager for the Debian/Ubuntu family vendors since SM is not shipped
#     by Ubuntu/Debian)
#   - "Global Registration (custom)" default global template that uses the
#     custom snippet
#   - foreman_url setting so registration commands point at the correct URL
# ------------------------------------------------------------------
echo "==== Creating registration templates ===="
HCONF=/root/.hammer/cli_config.yml
UHOST=$(awk '/:host:/{print $2}' "$HCONF")
UUSER=$(awk '/:username:/{print $2}' "$HCONF")
UPASS=$(awk '/:password:/{print $2}' "$HCONF")
SNIP_FILE=/root/katello-snippets/subscription_manager_setup.erb
TPL_FILE=/root/katello-snippets/global_registration_custom.erb

if [ -f "$SNIP_FILE" ]; then
  SID=$(curl -sk -u "$UUSER:$UPASS" "$UHOST/api/provisioning_templates?search=name%3D%22subscription_manager_setup%20(custom)%22" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
  if [ -n "$SID" ]; then
    python3 - "$SID" "$SNIP_FILE" "$UHOST" "$UUSER" "$UPASS" <<'PYEOF'
import json, sys, urllib.request, ssl
sid, snipfile, host, user, passwd = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
ctx = ssl.create_default_context(); ctx.check_hostname=False; ctx.verify_mode = ssl.CERT_NONE
body = open(snipfile).read()
data = json.dumps({"provisioning_template": {"template": body, "name": "subscription_manager_setup (custom)", "snippet": True}})
req = urllib.request.Request(host + "/api/provisioning_templates/" + sid, data=data.encode(), method="PUT",
      headers={"Content-Type": "application/json"});
import base64
req.add_header("Authorization", "Basic " + base64.b64encode((user + ":" + passwd).encode()).decode())
print(urllib.request.urlopen(req, context=ctx).status)
PYEOF
    echo "snippet 'subscription_manager_setup (custom)' updated"
  else
    hammer template create --name "subscription_manager_setup (custom)" --snippet --file "$SNIP_FILE" >/dev/null 2>&1 && echo "snippet created" || echo "WARN: snippet create failed"
  fi
else
  echo "WARN: $SNIP_FILE missing"
fi

if [ -f "$TPL_FILE" ]; then
  GID=$(curl -sk -u "$UUSER:$UPASS" "$UHOST/api/provisioning_templates?search=name%3D%22Global%20Registration%20(custom)%22" | grep -o '"id":[0-9]*' | head -1 | cut -d: -f2)
  if [ -n "$GID" ]; then
    python3 - "$GID" "$TPL_FILE" "$UHOST" "$UUSER" "$UPASS" <<'PYEOF'
import json, sys, urllib.request, ssl, base64
gid, tplfile, host, user, passwd = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
ctx = ssl.create_default_context(); ctx.check_hostname=False; ctx.verify_mode = ssl.CERT_NONE
body = open(tplfile).read()
data = json.dumps({"provisioning_template": {"template": body, "name": "Global Registration (custom)", "kind_id": 12}})
req = urllib.request.Request(host + "/api/provisioning_templates/" + gid, data=data.encode(), method="PUT",
      headers={"Content-Type": "application/json"})
req.add_header("Authorization", "Basic " + base64.b64encode((user + ":" + passwd).encode()).decode())
print(urllib.request.urlopen(req, context=ctx).status)
PYEOF
    echo "template 'Global Registration (custom)' updated"
  else
    hammer template create --name "Global Registration (custom)" --kind registration --file "$TPL_FILE" >/dev/null 2>&1 && echo "template created" || echo "WARN: template create failed"
  fi
  # Make the custom template the default for global registration
  BGID=$(printf '{"setting":{"value":"Global Registration (custom)"}}')
  RESP_S=$(curl -sk -u "$UUSER:$UPASS" -H "Content-Type: application/json" -X PUT -d "$BGID" "$UHOST/api/settings/default_global_registration_item")
  echo "$RESP_S" | grep -q '"custom"' && echo "default_global_registration_item set" || echo "WARN: default_global_registration_item failed"
else
  echo "WARN: $TPL_FILE missing"
fi

# Point foreman_url at the public URL (used in the generated commands)
if grep -q "^:foreman_url:" /etc/foreman/settings.yaml; then
  CUR_URL=$(sed 's/^:foreman_url: *//' /etc/foreman/settings.yaml | head -1)
  if [ "$CUR_URL" != "${foreman_public_url}" ]; then
    sed -i "s|^:foreman_url:.*|:foreman_url: ${foreman_public_url}|" /etc/foreman/settings.yaml
    echo "foreman_url updated to ${foreman_public_url}, restarting foreman"
    systemctl restart foreman
  fi
fi
%{ endif ~}

echo "==== Katello content setup finished ===="
hammer product list 2>/dev/null | head -25
