#!/bin/bash
# Creates Katello content: products, repositories (download on demand),
# GPG content credentials, rolling content views (one per product) and
# activation keys (AK <product>).
# Rendered by OpenTofu (templates/katello-repos.sh.tmpl) from the
# katello_gpg_keys / katello_yum_repos / katello_deb_repos /
# katello_subscription_manager_deb_repos variables.
# Logs: /root/katello-repos.log

set -uo pipefail

exec > >(tee /root/katello-repos.log) 2>&1

ORG="Default Organization"
SENTINEL="/root/katello-repos.published"

echo "==== Creating Katello content (products/repos/CVs/AKs) ===="

if ! hammer ping >/dev/null 2>&1; then
  echo "ERROR: hammer/Foreman API unreachable - aborting"
  exit 1
fi

touch "$SENTINEL"

gpg_id() {
  hammer content-credential info --organization "$ORG" --name "$1" 2>/dev/null \
    | awk '/^ *Id:/{print $2; exit}'
}

ensure_product() {
  hammer product create --organization "$ORG" --name "$1" \
    --description "Managed by Terraform" 2>/dev/null \
    || echo "product '$1' already exists"
}

cv_id() {
  hammer content-view info --organization "$ORG" --name "$1" 2>/dev/null \
    | awk '/^ *Id:/{print $2; exit}'
}

ensure_cv() {
  hammer content-view create --organization "$ORG" --name "$1" 2>/dev/null \
    || echo "content view '$1' already exists"
}

ensure_ak() {
  hammer activation-key info --organization "$ORG" --name "$1" >/dev/null 2>&1 \
    || hammer activation-key create --organization "$ORG" --name "$1" \
         --content-view "${2}" --lifecycle-environment Library \
         --unlimited-hosts 2>&1 \
    || echo "WARN: activation key '$1' create failed"
}

# ------------------------------------------------------------------
# GPG content credentials
# ------------------------------------------------------------------
mkdir -p /root/gpg-keys

%{ for i, key in katello_gpg_keys ~}
if curl -sSf --max-time 30 -o /root/gpg-keys/gpg-${i}.key "${key.url}"; then
  chmod 644 /root/gpg-keys/gpg-${i}.key
  if ! hammer content-credential info --organization "$ORG" --name "${key.name}" >/dev/null 2>&1; then
    hammer content-credential create --organization "$ORG" --name "${key.name}" \
      --content-type gpg_key --path /root/gpg-keys/gpg-${i}.key \
      || echo "WARN: could not create content credential '${key.name}'"
  else
    echo "content credential '${key.name}' already exists"
  fi
else
  echo "WARNING: could not download GPG key from ${key.url}"
fi
%{ endfor ~}

# ------------------------------------------------------------------
# Yum (RPM) repositories
# ------------------------------------------------------------------
%{ for r in katello_yum_repos ~}
ensure_product "${r.product}"
GPG_ARGS=""
%{ if r.gpg_key != "" ~}
GPG_ID=$(gpg_id "${r.gpg_key}")
if [ -n "$GPG_ID" ]; then GPG_ARGS="--gpg-key-id $GPG_ID"; fi
%{ endif ~}
echo "Creating yum repo ${r.product} / ${r.name}"
hammer repository create \
  --organization "$ORG" \
  --product "${r.product}" \
  --name "${r.name}" \
  --content-type yum \
  --url "${r.url}" \
  --download-policy "${r.download_policy}" \
  $GPG_ARGS \
  || echo "WARN: yum repo ${r.name} failed (already exists?)"
%{ endfor ~}

# ------------------------------------------------------------------
# Deb (Debian/Ubuntu) repositories incl. ATIX subscription-manager
# ------------------------------------------------------------------
%{ for r in katello_deb_all ~}
ensure_product "${r.product}"
GPG_ARGS=""
%{ if r.gpg_key != "" ~}
GPG_ID=$(gpg_id "${r.gpg_key}")
if [ -n "$GPG_ID" ]; then GPG_ARGS="--gpg-key-id $GPG_ID"; fi
%{ endif ~}
echo "Creating deb repo ${r.product} / ${r.name}"
hammer repository create \
  --organization "$ORG" \
  --product "${r.product}" \
  --name "${r.name}" \
  --content-type deb \
  --url "${r.url}" \
  --deb-releases "${r.releases}" \
  --deb-components "${r.components}" \
  --deb-architectures "${r.architectures}" \
  --download-policy "${r.download_policy}" \
  $GPG_ARGS \
  || echo "WARN: deb repo ${r.name} failed (already exists?)"
%{ endfor ~}

# ------------------------------------------------------------------
# Background metadata sync for every product
# ------------------------------------------------------------------
echo "==== Triggering background syncs ===="
PRODUCTS_FILE=$(mktemp)
%{ for r in katello_yum_repos ~}
echo "${r.product}" >> "$PRODUCTS_FILE"
%{ endfor ~}
%{ for r in katello_deb_all ~}
echo "${r.product}" >> "$PRODUCTS_FILE"
%{ endfor ~}

sort -u "$PRODUCTS_FILE" | while read -r p; do
  hammer product synchronize --async --organization "$ORG" --name "$p" \
    >/dev/null 2>&1 || echo "WARN: sync trigger failed for '$p'"
done

# ------------------------------------------------------------------
# Rolling content views (one per product, all repos of the product) + AKs
# ------------------------------------------------------------------
%{ if katello_activation_keys ~}
echo "==== Creating rolling content views & activation keys ===="

sort -u "$PRODUCTS_FILE" | while read -r p; do
  ensure_cv "$p"
done

%{ for r in katello_yum_repos ~}
CVID=$(cv_id "${r.product}")
if [ -n "$CVID" ]; then
  hammer content-view add-repository --id "$CVID" --product "${r.product}" --repository "${r.name}" \
    >/dev/null 2>&1 \
    || echo "repo ${r.name} already in CV ${r.product}"
fi
%{ endfor ~}
%{ for r in katello_deb_all ~}
CVID=$(cv_id "${r.product}")
if [ -n "$CVID" ]; then
  hammer content-view add-repository --id "$CVID" --product "${r.product}" --repository "${r.name}" \
    >/dev/null 2>&1 \
    || echo "repo ${r.name} already in CV ${r.product}"
fi
%{ endfor ~}

sort -u "$PRODUCTS_FILE" | while read -r p; do
  if grep -qx "$p" "$SENTINEL" 2>/dev/null; then
    echo "CV '$p' already published (sentinel)"
  else
    if hammer content-view publish --async --name "$p" --organization "$ORG" >/dev/null 2>&1; then
      echo "publish queued: $p"
      echo "$p" >> "$SENTINEL"
    else
      echo "WARN: publish failed for '$p' (retry after sync finished)"
    fi
  fi
done

sort -u "$PRODUCTS_FILE" | while read -r p; do
  ensure_ak "AK $p" "$p"
done
%{ endif ~}

rm -f "$PRODUCTS_FILE"

echo "==== Katello content setup finished ===="
hammer product list 2>/dev/null | head -25
