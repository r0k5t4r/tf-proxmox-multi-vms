#!/bin/bash
set -euxo pipefail

exec > >(tee /root/bootstrap-ceph.log) 2>&1

echo "Starting Ceph bootstrap"

cephadm bootstrap \
  --mon-ip ${bootstrap_ip} \
  --cluster-network ${cluster_network} \
  --allow-fqdn-hostname

ceph config set mon public_network ${public_networks}

echo "Installing cephadm SSH key on Ceph hosts"

for host in %{ for node in ceph_nodes ~}${node.ip} %{ endfor ~}; do
  sshpass -p '${ceph_ssh_pass}' ssh -o StrictHostKeyChecking=no ${ceph_ssh_user}@"$host" \
    "printf '%s\n' '${ceph_ssh_pass}' | sudo -S mkdir -p /root/.ssh && \
     printf '%s\n' '${ceph_ssh_pass}' | sudo -S chmod 700 /root/.ssh && \
     printf '%s\n' \"$(cat /etc/ceph/ceph.pub)\" | sudo tee -a /root/.ssh/authorized_keys >/dev/null && \
     printf '%s\n' '${ceph_ssh_pass}' | sudo -S chmod 600 /root/.ssh/authorized_keys"
done

echo "Adding Ceph hosts"

%{ for node in ceph_nodes }
ceph orch host add ${node.name}${domain != "" ? ".${domain}" : ""} ${node.ip}
%{ endfor }

echo "Deploying OSDs"

ceph orch apply osd --all-available-devices

echo "Waiting for cluster healthy (up to 20 min) + OSDs up"

for i in $(seq 1 40); do
  HEALTH=$(ceph -s | grep -o "HEALTH_[A-Z]+" | head -1 || true)
  OSDUP=$(ceph -s | grep -oE "osd: [0-9]+ osds: [0-9]+" | awk '{print $NF}' || echo 0)
  echo "[$i/40] health=$HEALTH osds_up=$OSDUP"
  if [ "${HEALTH}" = "HEALTH_OK" ] && [ "${OSDUP}" -ge 1 ]; then
    break
  fi
  sleep 30
done

echo "Creating pools for OpenStack (cinder volumes / glance images)"

ceph osd pool create volumes 64
ceph osd pool application enable volumes rbd || true
ceph osd pool create images 64
ceph osd pool application enable images rbd || true

echo "Creating client keyrings for OpenStack services"

ceph auth get-or-create client.cinder \
  mon 'profile rbd' \
  osd 'profile rbd pool=volumes, profile rbd pool=images' \
  mgr 'allow rw'
ceph auth get-or-create client.glance \
  mon 'profile rbd' \
  osd 'profile rbd pool=images' \
  mgr 'allow rw'

# Export the keyrings next to /etc/ceph so the OpenStack seed can fetch them.
ceph auth get-or-create client.cinder -o /opt/ceph.client.cinder.keyring
ceph auth get-or-create client.glance -o /opt/ceph.client.glance.keyring
chmod 600 /opt/ceph.client.*.keyring

echo "Ceph bootstrap finished"